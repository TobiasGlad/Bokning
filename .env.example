# Läses som processmiljö, inte automatiskt som dotenv-fil.
# Lokala värden kan också anges i .secrets/settings.json (aldrig i Git).
PUBLIC_ORIGIN=https://booking.example.invalid
ALLOWED_HOSTS=booking.example.invalid
SECURE_COOKIES=true
SSL_REDIRECT=true
HSTS_SECONDS=31536000
TRUST_PROXY_HTTPS=true
# Microsoft måste använda en specifik tenant, inte common/organizations.
MICROSOFT_TENANT=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Lämna tomt för att endast tillåta redan kopplade externa identiteter.
SSO_ALLOWED_DOMAINS=
